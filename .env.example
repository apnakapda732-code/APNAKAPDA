# Copy this file to .env  ->  cp .env.example .env
# Then fill the two blanks. NEVER commit .env and NEVER paste the secret in chat.

# ---- Razorpay LIVE keys ----
# Key ID is public (the browser is allowed to see it).
# Key SECRET is private: it lives ONLY in this file on the server.
# Get the secret from Dashboard > Account & Settings > API Keys.
RAZORPAY_KEY_ID=rzp_live_TqYUNCuC5Lspwu
RAZORPAY_KEY_SECRET=

# Optional but recommended: Dashboard > Webhooks > add https://your-server/api/webhook
# Events: payment.captured, payment.failed. Paste the secret Razorpay shows you.
RAZORPAY_WEBHOOK_SECRET=

# ---- Firebase ----
# Console > Project settings > Service accounts > Generate new private key.
# Paste the WHOLE json on ONE line, inside single quotes.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"apna-kapda-5b689",...}'

# Which website may call this server (comma separated, no trailing slash)
ALLOWED_ORIGIN=https://apna-kapda-5b689.web.app,https://apna-kapda-5b689.firebaseapp.com

PORT=8080
